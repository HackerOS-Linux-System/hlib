            ck(hlib_json::len(d, a) == 6, "array len")
            ck(hlib_json::uint_of(d, hlib_json::at(d, a, 0)) == 1, "uint")
            ck(hlib_json::kind(d, hlib_json::at(d, a, 1)) == 2, "num kind")
            ck(hlib_json::bool_of(d, hlib_json::at(d, a, 3)), "true")
            ck(hlib_json::kind(d, hlib_json::at(d, a, 5)) == 0, "null")
            ck(hlib_json::str_of(d, hlib_json::get(d, d.root, "s")) == "xé\n😀", "string escapes")
            ck(hlib_json::len(d, hlib_json::get(d, d.root, "o")) == 0, "empty object")
        end
        option::Result::Err(e) => is test::fail(e) end
    end
end

