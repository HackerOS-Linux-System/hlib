#[test]
fn signing_and_trust() is
    let kp: hlib_crypto::KeyPair = hlib_crypto::generate_keypair()
    let other: hlib_crypto::KeyPair = hlib_crypto::generate_keypair()
    let bt: hlib_build::Built = built(kp.signing_hex)
    let a: hlib_archive::Archive = opened(bt.archive)
    ck(a.manifest.signed && a.manifest.sig_public_key == kp.verifying_hex, "signed manifest")
    let ok: hlib_archive::Report = hlib_archive::check(a, kp.verifying_hex)
    ck(ok.ok && ok.signed && ok.signature_valid && ok.trusted, "trusted ok: " + hlib_bytes::join(ok.problems, "; "))
    let selfc: hlib_archive::Report = hlib_archive::check(a, "")
    ck(selfc.ok && selfc.signature_valid && !selfc.trusted, "embedded-key check is not trust")
    let wrong: hlib_archive::Report = hlib_archive::check(a, other.verifying_hex)
    ck(!wrong.ok, "wrong trusted key must fail")
    match hlib_archive::verify_signature(a, other.verifying_hex) is
        option::Result::Ok(_) => is test::fail("wrong key") end
        option::Result::Err(e) => is ck(e.code == "bad_signature", "bad_signature code") end
    end
end

;; rebuild the tar with one entry's bytes changed, keeping everything else
fn tampered(src: hlib_archive::Archive, victim: string, data: string) -> hlib_bytes::Buf is
    let mut es: [hlib_tar::Entry] = []
    for e in src.entries is
        if e.path == victim is
            es.push(hlib_tar::Entry { path: e.path, data: bs(data) })
        else
            es.push(e)
        end
    end
    match hlib_tar::write(es, 0) is
        option::Result::Ok(t) => is
            match hlib_zstd::compress(t, 3) is
                option::Result::Ok(c) => is return c end
                option::Result::Err(e) => is test::fail(e.message) end
            end
        end
        option::Result::Err(e) => is test::fail(e.message) end
    end
    return hlib_bytes::buf_new(0)
end

#[test]
fn tampering_is_detected() is
    let a: hlib_archive::Archive = opened(built("").archive)
    let t: hlib_archive::Archive = opened(tampered(a, "ast/demo.hcs", "fun evil() [ ]\n"))
    match hlib_archive::verify_checksums(t) is
        option::Result::Ok(_) => is test::fail("tampered content must fail") end
        option::Result::Err(e) => is ck(e.code == "checksum_mismatch", "mismatch code") end
    end
    ck(!hlib_archive::check(t, "").ok, "strict also fails")
    ;; an extra file CHECKSUMS does not cover: compat level accepts it, strict level must not
    let mut es: [hlib_tar::Entry] = []
    for e in a.entries is es.push(e) end
    es.push(hlib_tar::Entry { path: "native/evil.so", data: bs("payload") })
    let tar2: hlib_bytes::Buf = match hlib_tar::write(es, 0) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is hlib_bytes::buf_new(0) end
    end
    let comp2: hlib_bytes::Buf = match hlib_zstd::compress(tar2, 3) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is hlib_bytes::buf_new(0) end
    end
    let u: hlib_archive::Archive = opened(comp2)
    match hlib_archive::verify_checksums(u) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is test::fail("compat level should accept: " + e.message) end
    end
    let r: hlib_archive::Report = hlib_archive::check(u, "")
    ck(!r.ok && hlib_bytes::find_from(hlib_bytes::join(r.problems, "|"), "native/evil.so", 0) >= 0, "strict flags the unlisted file")
end

#[test]
fn open_rejects_garbage_and_duplicates() is
    match hlib_archive::open_bytes(bs("definitely not an archive"), "x", hlib_limits::default_limits()) is
        option::Result::Ok(_) => is test::fail("garbage") end
        option::Result::Err(e) => is ck(e.code == "not_archive", "not_archive") end
    end
    let es: [hlib_tar::Entry] = [hlib_tar::Entry { path: "manifest.json", data: bs("x") }, hlib_tar::Entry { path: "manifest.json", data: bs("y") }]
    let t: hlib_bytes::Buf = match hlib_tar::write(es, 0) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is hlib_bytes::buf_new(0) end
    end
    let c: hlib_bytes::Buf = match hlib_zstd::compress(t, 3) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is hlib_bytes::buf_new(0) end
    end
    match hlib_archive::open_bytes(c, "dup", hlib_limits::default_limits()) is
        option::Result::Ok(_) => is test::fail("duplicates") end
        option::Result::Err(e) => is ck(e.code == "duplicate_path", "duplicate_path") end
    end
end

