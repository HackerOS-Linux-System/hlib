#[test]
fn crypto_ed25519_rfc8032_vector() is
    ;; RFC 8032 §7.1, TEST 1 (empty message)
    let seed: string = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    let pubk: string = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    let expect: string = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
    match hlib_crypto::public_key_hex(seed) is
        option::Result::Ok(p) => is test::assert_true(p == pubk) end
        option::Result::Err(e) => is test::fail(e.message) end
    end
    let msg: hlib_bytes::Buf = hlib_bytes::buf_new(0)
    match hlib_crypto::sign(seed, msg) is
        option::Result::Ok(sig) => is
            test::assert_true(hlib_bytes::hex_encode(sig) == expect)
            match hlib_crypto::verify(pubk, msg, sig) is
                option::Result::Ok(v) => is test::assert_true(v) end
                option::Result::Err(e) => is test::fail(e.message) end
            end
            let other: hlib_bytes::Buf = bs("x")
            match hlib_crypto::verify(pubk, other, sig) is
                option::Result::Ok(v) => is test::assert_true(!v) end
                option::Result::Err(e) => is test::fail(e.message) end
            end
        end
        option::Result::Err(e) => is test::fail(e.message) end
    end
end

#[test]
fn crypto_key_errors() is
    match hlib_crypto::public_key_hex("abcd") is
        option::Result::Ok(_) => is test::fail("short key must fail") end
        option::Result::Err(e) => is
            test::assert_true(e.code == "bad_key")
            test::assert_true(e.message == "invalid ed25519 key material: signing key must be exactly 32 bytes (64 hex chars)")
        end
    end
    match hlib_crypto::public_key_hex("zz") is
        option::Result::Ok(_) => is test::fail("bad hex must fail") end
        option::Result::Err(e) => is test::assert_true(e.code == "bad_key") end
    end
    let kp: hlib_crypto::KeyPair = hlib_crypto::generate_keypair()
    test::assert_true(kp.signing_hex.len() == 64 && kp.verifying_hex.len() == 64)
    match hlib_crypto::public_key_hex(kp.signing_hex) is
        option::Result::Ok(p) => is test::assert_true(p == kp.verifying_hex) end
        option::Result::Err(e) => is test::fail(e.message) end
    end
end

#[test]
fn zstd_roundtrip_and_limits() is
    let mut sb: string = ""
    let mut i: int = 0
    while i < 2000 is
        sb += "hlib line " + to_string(i) + "\n"
        i += 1
    end
    let src: hlib_bytes::Buf = bs(sb)
    match hlib_zstd::compress(src, 19) is
        option::Result::Ok(c) => is
            test::assert_true(c.n < src.n)
            match hlib_zstd::decompress(c, 0) is
                option::Result::Ok(d) => is test::assert_true(hlib_bytes::buf_eq(d, src)) end
                option::Result::Err(e) => is test::fail(e.message) end
            end
            match hlib_zstd::decompress(c, 1000) is
                option::Result::Ok(d) => is test::fail("limit must trigger") end
                option::Result::Err(e) => is test::assert_true(e.code == "limit") end
            end
            let cut: hlib_bytes::Buf = hlib_bytes::buf_slice(c, 0, c.n / 2)
            match hlib_zstd::decompress(cut, 0) is
                option::Result::Ok(d) => is test::fail("truncated frame must fail") end
                option::Result::Err(e) => is test::assert_true(e.code == "zstd") end
            end
        end
        option::Result::Err(e) => is test::fail(e.message) end
    end
    match hlib_zstd::decompress(bs("this is not zstd data"), 0) is
        option::Result::Ok(d) => is test::fail("garbage must fail") end
        option::Result::Err(e) => is test::assert_true(e.code == "zstd") end
    end
end

#[test]
fn tar_roundtrip_incl_long_names() is
    let long: string = "extra/" + "very-long-directory-name/" + "another-long-directory-name/" + "and-another-one-here/" + "file-with-a-long-name.txt"
    ck(long.len() > 100, "long name is > 100")
    let es: [hlib_tar::Entry] = [
        hlib_tar::Entry { path: "manifest.json", data: bs("ab") },
        hlib_tar::Entry { path: "empty", data: hlib_bytes::buf_new(0) },
        hlib_tar::Entry { path: long, data: bs("long-content") },
        hlib_tar::Entry { path: "native/x86_64-unknown-linux-gnu/a.so", data: hlib_bytes::buf_new(1500) }
    ]
    match hlib_tar::write(es, 0) is
        option::Result::Ok(t) => is
            ck(t.n % 512 == 0, "tar length is a multiple of 512: " + to_string(t.n))
            match hlib_tar::read(t, hlib_limits::default_limits()) is
                option::Result::Ok(back) => is
                    ck(back.len() == 4, "4 entries, got " + to_string(back.len()))
                    ck(back[0].path == "manifest.json", "path0 " + back[0].path)
                    ck(back[0].data.n == 2, "size0")
                    ck(back[1].path == "empty", "path1 " + back[1].path)
                    ck(back[1].data.n == 0, "size1")
                    ck(back[2].path == long, "path2 " + back[2].path)
                    ck(hlib_bytes::buf_to_str(back[2].data) == "long-content", "data2")
                    ck(back[3].data.n == 1500, "size3")
                end
                option::Result::Err(e) => is test::fail(e.message) end
            end
        end
        option::Result::Err(e) => is test::fail(e.message) end
    end
end

#[test]
fn tar_rejects_unsafe_paths_on_write() is
    let bad: [string] = ["../x", "/etc/passwd", "a/../b", "a//b", "a\\b", "", "./", "C:/x", "a/./b"]
    for p in bad is
        let es: [hlib_tar::Entry] = [hlib_tar::Entry { path: p, data: bs("x") }]
        match hlib_tar::write(es, 0) is
            option::Result::Ok(_) => is test::fail("path should be refused: " + p) end
            option::Result::Err(e) => is test::assert_true(e.code == "unsafe_path") end
        end
    end
end

#[test]
fn tar_reader_rejects_corruption_and_links() is
    let es: [hlib_tar::Entry] = [hlib_tar::Entry { path: "a.txt", data: bs("hello") }]
    match hlib_tar::write(es, 0) is
        option::Result::Ok(t) => is
            ;; flip a byte of the name -> header checksum no longer matches
            let c: hlib_bytes::Buf = hlib_bytes::buf_copy(t)
            hlib_bytes::buf_set(c, 0, 66)
            match hlib_tar::read(c, hlib_limits::default_limits()) is
                option::Result::Ok(_) => is test::fail("corrupt header must fail") end
                option::Result::Err(e) => is test::assert_true(e.code == "tar") end
            end
            ;; entry limit
            let tiny: hlib_limits::Limits = hlib_limits::Limits {
                max_archive_bytes: 1000000, max_unpacked_bytes: 1000000, max_entry_bytes: 3,
                max_entries: 10, max_manifest_bytes: 1000, max_json_depth: 8
            }
            match hlib_tar::read(t, tiny) is
                option::Result::Ok(_) => is test::fail("entry size limit must trigger") end
                option::Result::Err(e) => is test::assert_true(e.code == "limit") end
            end
        end
        option::Result::Err(e) => is test::fail(e.message) end
    end
end

