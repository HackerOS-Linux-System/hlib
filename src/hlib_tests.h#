#[test]
fn bytes_hex_roundtrip() is
    let b: hlib_bytes::Buf = hlib_bytes::buf_from_str("hello\n")
    test::assert_true(hlib_bytes::hex_encode(b) == "68656c6c6f0a")
    match hlib_bytes::hex_decode("68656C6c6f0a") is
        option::Result::Ok(d) => is test::assert_true(hlib_bytes::buf_eq(d, b)) end
        option::Result::Err(e) => is test::fail(e) end
    end
    match hlib_bytes::hex_decode("abc") is
        option::Result::Ok(d) => is test::fail("odd length must fail") end
        option::Result::Err(e) => is test::assert_true(e == "Odd number of digits") end
    end
    match hlib_bytes::hex_decode("zz") is
        option::Result::Ok(d) => is test::fail("bad digit must fail") end
        option::Result::Err(e) => is test::assert_true(e == "Invalid character 'z' at position 0") end
    end
end

#[test]
fn bytes_utf8() is
    let ok: hlib_bytes::Buf = hlib_bytes::buf_from_str("zażółć 😀")
    test::assert_true(hlib_bytes::utf8_valid(ok, 0, ok.n))
    let bad: hlib_bytes::Buf = hlib_bytes::buf_new(2)
    hlib_bytes::buf_set(bad, 0, 195)
    hlib_bytes::buf_set(bad, 1, 40)
    test::assert_true(!hlib_bytes::utf8_valid(bad, 0, 2))
    let over: hlib_bytes::Buf = hlib_bytes::buf_new(2)
    hlib_bytes::buf_set(over, 0, 192)
    hlib_bytes::buf_set(over, 1, 128)
    test::assert_true(!hlib_bytes::utf8_valid(over, 0, 2))
    test::assert_true(hlib_bytes::utf8_encode(955) == "λ")
    test::assert_true(hlib_bytes::utf8_encode(128512) == "😀")
end

#[test]
fn bytes_file_roundtrip() is
    let path: string = "/tmp/hlib_t_bytes_" + to_string(os::pid()) + ".bin"
    let b: hlib_bytes::Buf = hlib_bytes::buf_new(300)
    let mut i: int = 0
    while i < 300 is
        hlib_bytes::buf_set(b, i, i % 256)
        i += 1
    end
    match hlib_bytes::write_file(path, b) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is test::fail(e.message) end
    end
    match hlib_bytes::read_file(path, 0) is
        option::Result::Ok(r) => is test::assert_true(hlib_bytes::buf_eq(r, b)) end
        option::Result::Err(e) => is test::fail(e.message) end
    end
    match hlib_bytes::read_file(path, 100) is
        option::Result::Ok(r) => is test::fail("limit must trigger") end
        option::Result::Err(e) => is test::assert_true(e.code == "limit") end
    end
    fs::remove(path)
end

