fn sample_manifest() -> hlib_manifest::Manifest is
    let m: hlib_manifest::Manifest = hlib_manifest::empty()
    m.name = "demo"
    m.version = "1.2.0"
    m.language = "hsharp"
    m.edition = "2026"
    m.language_version = "0.9.0"
    m.description = "quote \" and \\ and ł"
    m.authors = ["A", "B"]
    m.created_at = "2026-11-01T12:00:00Z"
    m.dependencies = [hlib_manifest::Dependency { name: "dep", version_req: "^1.0" }]
    m.artifacts = [hlib_manifest::Artifact { path: "native/x/demo.so", kind: "shared_object", target: "x", sha256: "ab", size: 7 }]
    m.exports = [hlib_manifest::Export { name: "add", kind: "function", signature: "fn add(a: i64) -> i64", params: ["i64", "opaque:Thing"], returns: "i64", generic: false, is_macro: false }]
    return m
end

#[test]
fn manifest_roundtrip_and_format() is
    let m: hlib_manifest::Manifest = sample_manifest()
    let text: string = hlib_manifest::to_json(m)
    ck(hlib_bytes::starts_with(text, "\{\n  \"hlib_spec_version\": 1,\n  \"name\": \"demo\","), "serde-style head")
    ck(hlib_bytes::find_from(text, "\"type\": \"opaque\",\n          \"struct_name\": \"Thing\"", 0) > 0, "nested pretty params")
    match hlib_manifest::parse(bs(text), hlib_limits::default_limits()) is
        option::Result::Ok(b) => is
            ck(b.name == "demo" && b.version == "1.2.0" && b.edition == "2026", "scalars")
            ck(b.description == m.description, "escapes survive")
            ck(b.authors.len() == 2 && b.dependencies[0].version_req == "^1.0", "lists")
            ck(b.artifacts[0].size == 7 && b.artifacts[0].target == "x", "artifact")
            ck(b.exports[0].params[1] == "opaque:Thing" && b.exports[0].returns == "i64", "export abi")
            ck(!b.signed, "unsigned")
            ck(hlib_manifest::to_json(b) == text, "stable re-serialisation")
        end
        option::Result::Err(e) => is test::fail(e.message) end
    end
end

#[test]
fn manifest_validation() is
    let lim: hlib_limits::Limits = hlib_limits::default_limits()
    match hlib_manifest::parse(bs("\{\"name\":\"x\"\}"), lim) is
        option::Result::Ok(_) => is test::fail("missing fields") end
        option::Result::Err(e) => is ck(e.code == "manifest", "code") end
    end
    let m: hlib_manifest::Manifest = sample_manifest()
    m.spec_version = 2
    match hlib_manifest::parse(bs(hlib_manifest::to_json(m)), lim) is
        option::Result::Ok(_) => is test::fail("newer spec") end
        option::Result::Err(e) => is ck(e.code == "unsupported_spec", "newer spec code") end
    end
    let m2: hlib_manifest::Manifest = sample_manifest()
    m2.edition = "1999"
    match hlib_manifest::parse(bs(hlib_manifest::to_json(m2)), lim) is
        option::Result::Ok(_) => is test::fail("edition") end
        option::Result::Err(e) => is ck(e.code == "unsupported_edition", "edition code") end
    end
    let m3: hlib_manifest::Manifest = sample_manifest()
    m3.language = "cobol"
    match hlib_manifest::parse(bs(hlib_manifest::to_json(m3)), lim) is
        option::Result::Ok(_) => is test::fail("language") end
        option::Result::Err(e) => is ck(e.code == "manifest", "language code") end
    end
    ck(hlib_manifest::valid_name("my-lib_2.x"), "valid name")
    ck(!hlib_manifest::valid_name("../x") && !hlib_manifest::valid_name("") && !hlib_manifest::valid_name(".hid") && !hlib_manifest::valid_name("a b"), "invalid names")
end

