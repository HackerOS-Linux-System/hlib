#[test]
fn json_parses_values() is
    match jp("  \{\"a\": [1, 2.5e3, -0, true, false, null], \"s\": \"x\\u00e9\\n\\ud83d\\ude00\", \"o\": \{\}\}  ") is
        option::Result::Ok(d) => is
