extern static [c] is
    fn malloc(n: int) -> int
    fn calloc(n: int, sz: int) -> int
    fn realloc(p: int, n: int) -> int
    fn free(p: int)
    fn memcpy(dst: int, src: int, n: int) -> int
    fn memset(dst: int, c: int, n: int) -> int
    fn memcmp(a: int, b: int, n: int) -> int
    fn strcpy(dst: int, src: string) -> int
    fn strndup(p: int, n: int) -> string
    fn fopen(path: string, mode: string) -> int
    fn fread(p: int, sz: int, n: int, f: int) -> int
    fn fwrite(p: int, sz: int, n: int, f: int) -> int
    fn fclose(f: int) -> int
    fn fflush(f: int) -> int
    fn fileno(f: int) -> int
    fn fsync(fd: int) -> int
    fn fseek(f: int, off: int, whence: int) -> int
    fn ftell(f: int) -> int
    fn fdopen(fd: int, mode: string) -> int
    fn rename(src_path: string, dst_path: string) -> int
    fn remove(path: string) -> int
    fn mkdir(path: string, mode: int) -> int
    fn chmod(path: string, mode: int) -> int
    fn getpid() -> int
end

