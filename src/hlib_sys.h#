    fn ZSTD_compressBound(n: int) -> int
    fn ZSTD_compress(dst: int, cap: int, src: int, n: int, level: int) -> int
    fn ZSTD_isError(code: int) -> int
    fn ZSTD_maxCLevel() -> int
    fn ZSTD_createDStream() -> int
    fn ZSTD_initDStream(ds: int) -> int
    fn ZSTD_decompressStream(ds: int, out: int, inp: int) -> int
    fn ZSTD_freeDStream(ds: int) -> int
end

extern static [c, "sodium"] is
    fn sodium_init() -> int
    fn sodium_memcmp(a: int, b: int, n: int) -> int
    fn crypto_hash_sha256(out: int, inp: int, n: int) -> int
    fn crypto_sign_keypair(pk: int, sk: int) -> int
    fn crypto_sign_seed_keypair(pk: int, sk: int, seed: int) -> int
    fn crypto_sign_detached(sig: int, siglen: int, m: int, mlen: int, sk: int) -> int
    fn crypto_sign_verify_detached(sig: int, m: int, mlen: int, pk: int) -> int
    fn crypto_core_ed25519_add(r: int, p: int, q: int) -> int
