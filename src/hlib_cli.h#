;; ── argument helpers ──────────────────────────────────────────────────────────

fn takes_value(flag: string) -> bool is
    let vf: [string] = [
        "-o", "--output", "--name", "--version", "--lang", "--language", "--lang-version", "--edition",
        "--description", "--author", "--dep", "--so", "--target", "--ast", "--header", "--bytecode",
        "--exports", "--extra", "--sign", "--level", "--created-at", "--pubkey", "--pubkey-file",
        "--into", "--out", "--from"
    ]
    for f in vf is
        if f == flag is return true end
    end
    return false
end

;; the first value of `flag` ("" when absent)
fn opt(args: [string], flag: string) -> string is
    let mut i: int = 0
    while i + 1 < args.len() is
        if args[i] == flag is return args[i + 1] end
        i += 1
    end
    return ""
end

fn opt_any(args: [string], flags: [string]) -> string is
    for f in flags is
        let v: string = opt(args, f)
        if v != "" is return v end
    end
    return ""
end

fn opts(args: [string], flag: string) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i + 1 < args.len() is
        if args[i] == flag is out.push(args[i + 1]) end
        i += 1
    end
    return out
end

fn flag(args: [string], name: string) -> bool is
    for a in args is
        if a == name is return true end
    end
    return false
end

fn positionals(args: [string]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < args.len() is
        let a: string = args[i]
        if hlib_bytes::starts_with(a, "-") && a.len() > 1 is
            if takes_value(a) is i += 1 end
        else
            out.push(a)
        end
        i += 1
    end
    return out
end

fn unknown_flags(args: [string], allowed: [string]) -> string is
    let mut i: int = 0
    while i < args.len() is
        let a: string = args[i]
        if hlib_bytes::starts_with(a, "-") && a.len() > 1 is
            let mut ok: bool = false
            for x in allowed is
                if x == a is ok = true end
            end
            if !ok is return a end
            if takes_value(a) is i += 1 end
        end
        i += 1
    end
    return ""
end

;; ── commands ──────────────────────────────────────────────────────────────────

pub fn default_target() -> string is
    let t: string = env::get("HLIB_TARGET")
    if t != "" is return t end
    return os::arch() + "-unknown-linux-gnu"
end

fn read_key_file(path: string) -> option::Result<string, hlib_error::HlibError> is
    let b: hlib_bytes::Buf = hlib_bytes::read_file(path, 4096)?
    return option::Result::Ok(hlib_bytes::trim_ws(hlib_bytes::buf_to_str(b)))
end

fn cmd_build(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["-o", "--output", "--name", "--version", "--lang", "--language", "--lang-version", "--edition", "--description", "--author", "--dep", "--so", "--target", "--ast", "--header", "--bytecode", "--exports", "--extra", "--sign", "--level", "--created-at"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `build`") end
    let output: string = opt_any(args, ["-o", "--output"])
    let name: string = opt(args, "--name")
    let version: string = opt(args, "--version")
    let lang: string = opt_any(args, ["--lang", "--language"])
    if output == "" || name == "" || version == "" || lang == "" is
        return usage_error("`build` needs -o, --name, --version and --lang")
    end
    let mut b: hlib_build::Builder = hlib_build::Builder {
        name: "", version: "", language: "", language_version: "", edition: "", description: "", authors: [],
        dependencies: [], exports: [], artifacts: [], entries: [], created_at: "", level: 19
    }
    match hlib_build::builder_new(name, version, lang) is
        option::Result::Ok(x) => is b = x end
        option::Result::Err(e) => is return fail(e) end
    end
    b.language_version = opt(args, "--lang-version")
    b.edition = opt(args, "--edition")
    b.description = opt(args, "--description")
    b.created_at = opt(args, "--created-at")
    let lv: string = opt(args, "--level")
    if lv != "" is
        let n: int = parse_small(lv)
        if n < 1 || n > 22 is return usage_error("--level must be 1..22") end
        b.level = n
    end
    for a in opts(args, "--author") is hlib_build::add_author(b, a) end
    for d in opts(args, "--dep") is
        let eq: int = hlib_bytes::find_from(d, "=", 0)
        if eq <= 0 is return usage_error("--dep expects NAME=REQ, got `" + d + "`") end
        hlib_build::add_dependency(b, d[0..eq], d[eq + 1..d.len()])
    end

    let so: string = opt(args, "--so")
    if so != "" is
        let target: string = if opt(args, "--target") != "" is opt(args, "--target") else default_target() end
        match hlib_build::add_file(b, "native/" + target + "/" + name + ".so", "shared_object", target, so) is
            option::Result::Ok(_) => is end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let ast: string = opt(args, "--ast")
    if ast != "" is
        match hlib_bytes::read_file(ast, 1073741824) is
            option::Result::Ok(d) => is
                match hlib_build::add_ast(b, d) is
                    option::Result::Ok(_) => is end
                    option::Result::Err(e) => is return fail(e) end
                end
            end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let bc: string = opt(args, "--bytecode")
    if bc != "" is
        match hlib_bytes::read_file(bc, 1073741824) is
            option::Result::Ok(d) => is
                match hlib_build::add_bytecode(b, d) is
                    option::Result::Ok(_) => is end
                    option::Result::Err(e) => is return fail(e) end
                end
            end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let mut header_given: bool = false
    let hd: string = opt(args, "--header")
    if hd != "" is
        header_given = true
        match hlib_bytes::read_file(hd, 67108864) is
            option::Result::Ok(d) => is
                match hlib_build::add_header(b, d) is
                    option::Result::Ok(_) => is end
                    option::Result::Err(e) => is return fail(e) end
                end
            end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let ex: string = opt(args, "--exports")
    if ex != "" is
        match hlib_bytes::read_file(ex, 67108864) is
            option::Result::Ok(d) => is
                match hlib_manifest::parse_exports(d, hlib_limits::default_limits()) is
                    option::Result::Ok(list) => is
                        b.exports = list
                        if !header_given is
                            let hb: hlib_bytes::Buf = hlib_bytes::buf_from_str(hlib_manifest::exports_json(list) + "\n")
                            match hlib_build::add_header(b, hb) is
                                option::Result::Ok(_) => is end
                                option::Result::Err(e) => is return fail(e) end
                            end
                        end
                    end
                    option::Result::Err(e) => is return fail(e) end
                end
            end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    for x in opts(args, "--extra") is
        let eq: int = hlib_bytes::find_from(x, "=", 0)
        if eq <= 0 is return usage_error("--extra expects NAME=FILE, got `" + x + "`") end
        match hlib_bytes::read_file(x[eq + 1..x.len()], 1073741824) is
            option::Result::Ok(d) => is
                match hlib_build::add_extra(b, x[0..eq], d) is
                    option::Result::Ok(_) => is end
                    option::Result::Err(e) => is return fail(e) end
                end
            end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let mut key: string = ""
    let kf: string = opt(args, "--sign")
    if kf != "" is
        match read_key_file(kf) is
            option::Result::Ok(k) => is key = k end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    match hlib_build::finish(b, output, key) is
        option::Result::Ok(m) => is
            out("built " + output + "  (" + m.name + " " + m.version + ", " + to_string(m.artifacts.len()) + " artifact(s), " + (if m.signed is "signed" else "unsigned" end) + ")")
            return 0
        end
        option::Result::Err(e) => is return fail(e) end
    end
end

fn parse_small(s: string) -> int is
    if s.len() == 0 || s.len() > 4 is return -1 end
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        if c < 48 || c > 57 is return -1 end
        v = v * 10 + (c - 48)
        i += 1
    end
    return v
end

fn open_arg(args: [string]) -> option::Result<hlib_archive::Archive, hlib_error::HlibError> is
    let pos: [string] = positionals(args)
    if pos.len() < 1 is return option::Result::Err(hlib_error::invalid("missing FILE argument")) end
    return hlib_archive::open(pos[0])
end

fn short(s: string, n: int) -> string is
    if s.len() <= n is return s end
    return s[0..n]
end

fn cmd_inspect(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["--json"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `inspect`") end
    let a: hlib_archive::Archive = match open_arg(args) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is
            if e.code == "invalid_input" is return usage_error(e.message) end
            return fail(e)
        end
    end
    let m: hlib_manifest::Manifest = a.manifest
    if flag(args, "--json") is
        out(hlib_manifest::to_json(m))
        return 0
    end
    out("hlib: " + m.name + " v" + m.version + " (" + m.language + ")")
    out("  spec version:  " + to_string(m.spec_version))
    out("  abi version:   " + to_string(m.abi_version))
    if m.language_version != "" is out("  built by:      " + m.language + " " + m.language_version) end
    if m.edition != "" is out("  edition:       " + m.edition) end
    if m.description != "" is out("  description:   " + m.description) end
    if m.authors.len() > 0 is out("  authors:       " + hlib_bytes::join(m.authors, ", ")) end
    out("  created at:    " + m.created_at)
    if m.signed is out("  signed:        yes (" + m.sig_algorithm + ", key " + m.sig_public_key + ")") else out("  signed:        no") end
    if m.dependencies.len() > 0 is
        out("  dependencies (" + to_string(m.dependencies.len()) + "):")
        for d in m.dependencies is out("    " + d.name + " " + d.version_req) end
    end
    out("  artifacts (" + to_string(m.artifacts.len()) + "):")
    for x in m.artifacts is
        out("    " + hlib_bytes::join([x.kind, x.path, to_string(x.size) + " bytes", "sha256:" + short(x.sha256, 16)], "  "))
    end
    out("  exports (" + to_string(m.exports.len()) + "):")
    for e in m.exports is out("    " + e.signature) end
    return 0
end

fn cmd_list(args: [string]) -> int is
    let a: hlib_archive::Archive = match open_arg(args) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is
            if e.code == "invalid_input" is return usage_error(e.message) end
            return fail(e)
        end
    end
    for p in hlib_archive::entry_paths(a) is
        let i: int = hlib_archive::entry_index(a, p)
        out(to_string(a.entries[i].data.n) + "\t" + p)
    end
    return 0
end

fn json_array(items: [string]) -> string is
    let mut q: [string] = []
    for i in items is q.push(hlib_json::quote(i)) end
    return "[" + hlib_bytes::join(q, ", ") + "]"
end

fn cmd_verify(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["--pubkey", "--pubkey-file", "--compat", "--json"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `verify`") end
    let a: hlib_archive::Archive = match open_arg(args) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is
            if e.code == "invalid_input" is return usage_error(e.message) end
            return fail(e)
        end
    end
    let mut key: string = opt(args, "--pubkey")
    let kf: string = opt(args, "--pubkey-file")
    if kf != "" is
        match read_key_file(kf) is
            option::Result::Ok(k) => is key = k end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let want_json: bool = flag(args, "--json")
    if flag(args, "--compat") is
        let mut problems: [string] = []
        match hlib_archive::verify_checksums(a) is
            option::Result::Ok(_) => is end
            option::Result::Err(e) => is problems.push(e.message) end
        end
        if key != "" is
            match hlib_archive::verify_signature(a, key) is
                option::Result::Ok(_) => is end
                option::Result::Err(e) => is problems.push(e.message) end
            end
        end
        if want_json is
            out(hlib_json::lbrace() + "\"ok\": " + (if problems.len() == 0 is "true" else "false" end) + ", \"strict\": false, \"problems\": " + json_array(problems) + hlib_json::rbrace())
        else
            for p in problems is err("hlib: " + p) end
            if problems.len() == 0 is out("ok: checksums" + (if key != "" is " and signature" else "" end) + " verified (compat level)") end
        end
        return if problems.len() == 0 is 0 else 1 end
    end
    let r: hlib_archive::Report = hlib_archive::check(a, key)
    if want_json is
        out(hlib_json::lbrace() + "\"ok\": " + (if r.ok is "true" else "false" end) + ", \"strict\": true, \"signed\": " + (if r.signed is "true" else "false" end) + ", \"signature_valid\": " + (if r.signature_valid is "true" else "false" end) + ", \"trusted\": " + (if r.trusted is "true" else "false" end) + ", \"problems\": " + json_array(r.problems) + hlib_json::rbrace())
    else
        for p in r.problems is err("hlib: " + p) end
        if r.ok is
            let sig: string = if !r.signed is "unsigned" elsif r.trusted is "signature valid, key trusted" else "signature consistent with the embedded key only (pass --pubkey to establish trust)" end
            out("ok: " + a.manifest.name + " " + a.manifest.version + " verified (strict) — " + sig)
        end
    end
    return if r.ok is 0 else 1 end
end

fn cmd_extract(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["--into", "--no-verify"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `extract`") end
    let a: hlib_archive::Archive = match open_arg(args) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is
            if e.code == "invalid_input" is return usage_error(e.message) end
            return fail(e)
        end
    end
    if !flag(args, "--no-verify") is
        let r: hlib_archive::Report = hlib_archive::check(a, "")
        if !r.ok is
            for p in r.problems is err("hlib: " + p) end
            err("hlib: refusing to extract an archive that fails verification (--no-verify to override)")
            return 1
        end
    end
    let mut dir: string = opt(args, "--into")
    if dir == "" is dir = a.manifest.name end
    match hlib_archive::extract_to_dir(a, dir) is
        option::Result::Ok(_) => is
            out("extracted " + to_string(a.entries.len()) + " entries to " + dir)
            return 0
        end
        option::Result::Err(e) => is return fail(e) end
    end
end

fn cmd_manifest(args: [string]) -> int is
    let a: hlib_archive::Archive = match open_arg(args) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is
            if e.code == "invalid_input" is return usage_error(e.message) end
            return fail(e)
        end
    end
    let i: int = hlib_archive::entry_index(a, hlib_archive::manifest_entry())
    let f: int = hlib_sys::fdopen(1, "w")
    let d: hlib_bytes::Buf = a.entries[i].data
    if d.n > 0 is hlib_sys::fwrite(d.p, 1, d.n, f) end
    hlib_sys::fflush(f)
    return 0
end

fn cmd_cat(args: [string]) -> int is
    let pos: [string] = positionals(args)
    if pos.len() < 2 is return usage_error("`cat` needs FILE and ENTRY") end
    match hlib_archive::open(pos[0]) is
        option::Result::Ok(a) => is
            match hlib_archive::entry_bytes(a, pos[1]) is
                option::Result::Ok(d) => is
                    let f: int = hlib_sys::fdopen(1, "w")
                    if d.n > 0 is hlib_sys::fwrite(d.p, 1, d.n, f) end
                    hlib_sys::fflush(f)
                    return 0
                end
                option::Result::Err(e) => is return fail(e) end
            end
        end
        option::Result::Err(e) => is return fail(e) end
    end
end

fn cmd_keygen(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["--out", "--force"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `keygen`") end
    let path: string = opt(args, "--out")
    if path == "" is return usage_error("`keygen` needs --out FILE") end
    if fs::exists(path) && !flag(args, "--force") is
        err("hlib: " + path + " already exists (use --force to replace it)")
        return 1
    end
    let kp: hlib_crypto::KeyPair = hlib_crypto::generate_keypair()
    match hlib_bytes::write_file_mode(path, hlib_bytes::buf_from_str(kp.signing_hex + "\n"), 384) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is return fail(e) end
    end
    err("secret key written to " + path + " (mode 0600) — keep it private")
    out(kp.verifying_hex)
    return 0
end

fn cmd_find(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["--lang", "--from", "--version"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `find`") end
    let pos: [string] = positionals(args)
    if pos.len() < 1 is return usage_error("`find` needs a library NAME") end
    let mut lang: string = "hsharp"
    if opt(args, "--lang") != "" is
        match hlib_manifest::language_from_str(opt(args, "--lang")) is
            option::Result::Ok(l) => is lang = l end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let from: string = if opt(args, "--from") != "" is opt(args, "--from") else fs::cwd() end
    match hlib_search::find(pos[0], opt(args, "--version"), lang, from) is
        option::Result::Ok(p) => is
            out(p)
            return 0
        end
        option::Result::Err(e) => is return fail(e) end
    end
end

;; AbiType -> HackerScript type ("" = cannot be bound)
fn hcs_type(t: string) -> string is
    if t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "u8" || t == "u16" || t == "u32" || t == "u64" is return "Int" end
    if t == "f32" || t == "f64" is return "Float" end
    if t == "bool" is return "Bool" end
    if t == "ptr" is return "Str" end
    return ""
end

;; the `get <extern:…>` + `region [ … ]` stub for the non-generic function exports of `m`
pub fn hcs_stub(m: hlib_manifest::Manifest, so_path: string, from_file: string) -> string is
    let mut body: [string] = []
    let mut skipped: [string] = []
    for e in m.exports is
        if e.kind != "function" || e.generic || e.is_macro is
            skipped.push(e.name + " (kind=" + e.kind + ", generic=" + (if e.generic is "true" else "false" end) + ", is_macro=" + (if e.is_macro is "true" else "false" end) + ")")
        else
            let mut ps: [string] = []
            let mut ok: bool = true
            let mut k: int = 0
            for p in e.params is
                let t: string = hcs_type(p)
                if t == "" is ok = false else ps.push("p" + to_string(k) + ": " + t) end
                k += 1
            end
            let mut ret: string = ""
            if e.returns != "" && e.returns != "void" is
                let rt: string = hcs_type(e.returns)
                if rt == "" is ok = false else ret = " -> " + rt end
            end
            if ok is
                body.push("    fun " + e.name + "(" + hlib_bytes::join(ps, ", ") + ")" + ret)
            else
                skipped.push(e.name + " (a type outside the bindable ABI set)")
            end
        end
    end
    let mut sb: [string] = []
    sb.push("!!! generated by `hlib import` from " + from_file + " — do not edit")
    sb.push("get <extern:" + so_path + "> use <dynamic>")
    sb.push("region [")
    if body.len() == 0 is sb.push("    !! no export can be bound automatically") else sb.push(hlib_bytes::join(body, "\n")) end
    sb.push("]")
    if skipped.len() > 0 is
        sb.push("")
        sb.push("!! skipped (cannot be bound automatically):")
        for x in skipped is sb.push("!!   - " + x) end
    end
    return hlib_bytes::join(sb, "\n") + "\n"
end

fn cmd_import(args: [string]) -> int is
    let bad: string = unknown_flags(args, ["--into", "--name"])
    if bad != "" is return usage_error("unknown option `" + bad + "` for `import`") end
    let a: hlib_archive::Archive = match open_arg(args) is
        option::Result::Ok(x) => is x end
        option::Result::Err(e) => is
            if e.code == "invalid_input" is return usage_error(e.message) end
            return fail(e)
        end
    end
    let into: string = opt(args, "--into")
    if into == "" is return usage_error("`import` needs --into DIR") end
    let name: string = if opt(args, "--name") != "" is opt(args, "--name") else a.manifest.name end
    let r: hlib_archive::Report = hlib_archive::check(a, "")
    if !r.ok is
        for p in r.problems is err("hlib: " + p) end
        err("hlib: refusing to import an archive that fails verification")
        return 1
    end
    hlib_bytes::make_dirs(into)
    let ast: string = "ast/" + name + ".hcs"
    if hlib_archive::has_entry(a, ast) is
        let dest: string = into + "/" + name + ".hcs"
        match hlib_archive::extract_entry(a, ast, dest) is
            option::Result::Ok(_) => is
                out(dest)
                return 0
            end
            option::Result::Err(e) => is return fail(e) end
        end
    end
    let mut so: string = ""
    let want: string = "native/" + default_target() + "/" + name + ".so"
    if hlib_archive::has_entry(a, want) is
        so = want
    else
        for p in hlib_archive::entry_paths(a) is
            if so == "" && hlib_bytes::starts_with(p, "native/") && hlib_bytes::ends_with(p, "/" + name + ".so") is so = p end
        end
    end
    if so == "" is
        err("hlib: '" + name + "' has neither an ast/" + name + ".hcs artifact nor a native .so — nothing to import")
        return 1
    end
    let so_dest: string = into + "/native-cache/lib" + name + ".so"
    match hlib_archive::extract_entry(a, so, so_dest) is
        option::Result::Ok(_) => is end
        option::Result::Err(e) => is return fail(e) end
    end
    let stub: string = into + "/" + name + "_hlib_bind.hcs"
    match hlib_bytes::write_file(stub, hlib_bytes::buf_from_str(hcs_stub(a.manifest, so_dest, a.path))) is
        option::Result::Ok(_) => is
            out(stub)
            return 0
        end
        option::Result::Err(e) => is return fail(e) end
    end
end

;; Runs the CLI. `args` are the arguments after the program name.
pub fn run(args: [string]) -> int is
    if args.len() == 0 is
        err(help_text())
        return 2
    end
    let cmd: string = args[0]
    let mut rest: [string] = []
    let mut i: int = 1
    while i < args.len() is
        rest.push(args[i])
        i += 1
    end
    if cmd == "help" || cmd == "--help" || cmd == "-h" is
        out(help_text())
        return 0
    end
    if cmd == "version" || cmd == "--version" || cmd == "-V" is
        out("hlib 1.0.0 (hlib spec v1)")
        return 0
    end
    if cmd == "build" is return cmd_build(rest) end
    if cmd == "inspect" || cmd == "info" is return cmd_inspect(rest) end
    if cmd == "list" || cmd == "ls" is return cmd_list(rest) end
    if cmd == "verify" || cmd == "check" is return cmd_verify(rest) end
    if cmd == "extract" is return cmd_extract(rest) end
    if cmd == "manifest" is return cmd_manifest(rest) end
    if cmd == "cat" is return cmd_cat(rest) end
    if cmd == "keygen" is return cmd_keygen(rest) end
    if cmd == "find" || cmd == "path" is return cmd_find(rest) end
    if cmd == "import" is return cmd_import(rest) end
    return usage_error("unknown command `" + cmd + "`")
end
