;; ── output ────────────────────────────────────────────────────────────────────

fn emit(fd: int, s: string) is
    let f: int = hlib_sys::fdopen(fd, "w")
    let b: hlib_bytes::Buf = hlib_bytes::buf_from_str(s)
    if b.n > 0 is hlib_sys::fwrite(b.p, 1, b.n, f) end
    hlib_sys::fflush(f)
    hlib_bytes::buf_free(b)
end

fn out(s: string) is emit(1, s + "\n") end
fn err(s: string) is emit(2, s + "\n") end

fn fail(e: hlib_error::HlibError) -> int is
    err("hlib: " + e.message)
    return 1
end

fn usage_error(msg: string) -> int is
    err("hlib: " + msg)
    err("try `hlib help`")
    return 2
end

