use "std -> option" from "option"
use "std -> strbuf" from "strbuf"

mod hlib_bytes

pub struct JNode is
    pub kind: int        ;; 0 null, 1 bool, 2 number, 3 string, 4 array, 5 object
    pub s: string        ;; string value, or raw number text
    pub b: bool
    pub key: string      ;; the key of this node inside its parent object
    pub first: int       ;; first child (arrays / objects) or -1
    pub last: int        ;; last child or -1
    pub next: int        ;; next sibling or -1
    pub count: int
end

pub struct JDoc is
    pub nodes: [JNode]
    pub root: int
end

struct P is
    pub b: hlib_bytes::Buf
    pub i: int
    pub err: string
    pub depth: int
    pub max_depth: int
    pub nodes: [JNode]
end

pub fn lbrace() -> string is return str_from_byte(123) end
pub fn rbrace() -> string is return str_from_byte(125) end

fn fail(p: P, m: string) -> int is
    if p.err == "" is p.err = m + " at byte " + to_string(p.i) end
    return -1
end

fn add(p: P, kind: int, s: string, b: bool) -> int is
    p.nodes.push(JNode { kind: kind, s: s, b: b, key: "", first: -1, last: -1, next: -1, count: 0 })
    return p.nodes.len() - 1
end

@pointers
fn cur(p: P) -> int is
    if p.i >= p.b.n is return -1 end
    return ptr_read_i8(p.b.p, p.i) & 255
end

fn ws(p: P) is
    while true is
        let c: int = cur(p)
        if c == 32 || c == 9 || c == 10 || c == 13 is p.i += 1 else break end
    end
end

fn hex4(p: P) -> int is
    let mut v: int = 0
    let mut k: int = 0
    while k < 4 is
        let c: int = cur(p)
        let d: int = if c >= 48 && c <= 57 is c - 48 elsif c >= 97 && c <= 102 is c - 87 elsif c >= 65 && c <= 70 is c - 55 else -1 end
        if d < 0 is return -1 end
        v = v * 16 + d
        p.i += 1
        k += 1
    end
    return v
end

;; at the opening quote; returns the decoded text, "" with p.err set on failure
fn parse_string(p: P) -> string is
    p.i += 1
    let mut sb = strbuf::new()
    while true is
        let c: int = cur(p)
        if c < 0 is
            fail(p, "unterminated string")
            return ""
        end
        if c == 34 is
            p.i += 1
            return sb.build()
        end
        if c < 32 is
            fail(p, "control character in string")
            return ""
        end
        if c == 92 is
            p.i += 1
            let e: int = cur(p)
            p.i += 1
            if e == 34 is sb.push("\"")
            elsif e == 92 is sb.push("\\")
            elsif e == 47 is sb.push("/")
            elsif e == 98 is sb.push(str_from_byte(8))
            elsif e == 102 is sb.push(str_from_byte(12))
            elsif e == 110 is sb.push("\n")
            elsif e == 114 is sb.push("\r")
            elsif e == 116 is sb.push("\t")
            elsif e == 117 is
                let mut cp: int = hex4(p)
                if cp < 0 is
                    fail(p, "invalid \\u escape")
                    return ""
                end
                if cp >= 55296 && cp <= 56319 is
                    if cur(p) == 92 && p.i + 1 < p.b.n is
                        p.i += 1
                        if cur(p) != 117 is
                            fail(p, "lone surrogate")
                            return ""
                        end
                        p.i += 1
                        let lo: int = hex4(p)
                        if lo < 56320 || lo > 57343 is
                            fail(p, "lone surrogate")
                            return ""
                        end
                        cp = 65536 + ((cp - 55296) << 10) + (lo - 56320)
                    else
                        fail(p, "lone surrogate")
                        return ""
                    end
                elsif cp >= 56320 && cp <= 57343 is
                    fail(p, "lone surrogate")
                    return ""
                end
                if cp == 0 is
                    fail(p, "\\u0000 is not supported")
                    return ""
                end
                sb.push(hlib_bytes::utf8_encode(cp))
            else
                fail(p, "invalid escape")
                return ""
            end
        else
            sb.push(str_from_byte(c))
            p.i += 1
        end
    end
    return ""
end

fn parse_number(p: P) -> int is
    let start: int = p.i
    if cur(p) == 45 is p.i += 1 end
    let c0: int = cur(p)
    if c0 == 48 is
        p.i += 1
    elsif c0 >= 49 && c0 <= 57 is
        while cur(p) >= 48 && cur(p) <= 57 is p.i += 1 end
    else
        return fail(p, "invalid number")
    end
    if cur(p) == 46 is
        p.i += 1
        if !(cur(p) >= 48 && cur(p) <= 57) is return fail(p, "invalid number") end
        while cur(p) >= 48 && cur(p) <= 57 is p.i += 1 end
    end
    if cur(p) == 101 || cur(p) == 69 is
        p.i += 1
        if cur(p) == 43 || cur(p) == 45 is p.i += 1 end
        if !(cur(p) >= 48 && cur(p) <= 57) is return fail(p, "invalid number") end
        while cur(p) >= 48 && cur(p) <= 57 is p.i += 1 end
    end
    let raw: string = hlib_bytes::buf_to_str(hlib_bytes::buf_slice(p.b, start, p.i - start))
    return add(p, 2, raw, false)
end

fn literal(p: P, word: string, kind: int, b: bool) -> int is
    let n: int = word.len()
    if p.i + n > p.b.n is return fail(p, "invalid literal") end
    let got: string = hlib_bytes::buf_to_str(hlib_bytes::buf_slice(p.b, p.i, n))
    if got != word is return fail(p, "invalid literal") end
    p.i += n
    return add(p, kind, "", b)
end

fn link(p: P, parent: int, child: int) is
    let par: JNode = p.nodes[parent]
    if par.last >= 0 is p.nodes[par.last].next = child else par.first = child end
    par.last = child
    par.count += 1
end

fn has_key(p: P, obj: int, key: string) -> bool is
    let mut c: int = p.nodes[obj].first
    while c >= 0 is
        if p.nodes[c].key == key is return true end
        c = p.nodes[c].next
    end
    return false
end

fn parse_value(p: P) -> int is
    ws(p)
    let c: int = cur(p)
    if c < 0 is return fail(p, "unexpected end of input") end
    if c == 34 is
        let s: string = parse_string(p)
        if p.err != "" is return -1 end
        return add(p, 3, s, false)
    end
    if c == 116 is return literal(p, "true", 1, true) end
    if c == 102 is return literal(p, "false", 1, false) end
    if c == 110 is return literal(p, "null", 0, false) end
    if c == 45 || (c >= 48 && c <= 57) is return parse_number(p) end
    if c != 91 && c != 123 is return fail(p, "unexpected character") end
    p.depth += 1
    if p.depth > p.max_depth is return fail(p, "nesting deeper than " + to_string(p.max_depth)) end
    let is_arr: bool = c == 91
    let node: int = add(p, if is_arr is 4 else 5 end, "", false)
    p.i += 1
    ws(p)
    if cur(p) == (if is_arr is 93 else 125 end) is
        p.i += 1
        p.depth -= 1
        return node
    end
    while true is
        ws(p)
        let mut key: string = ""
        if !is_arr is
            if cur(p) != 34 is return fail(p, "object key must be a string") end
            key = parse_string(p)
            if p.err != "" is return -1 end
            if has_key(p, node, key) is return fail(p, "duplicate key `" + key + "`") end
            ws(p)
            if cur(p) != 58 is return fail(p, "expected `:`") end
            p.i += 1
        end
        let child: int = parse_value(p)
        if child < 0 is return -1 end
        p.nodes[child].key = key
        link(p, node, child)
        ws(p)
        let d: int = cur(p)
        if d == 44 is
            p.i += 1
        elsif d == (if is_arr is 93 else 125 end) is
            p.i += 1
            p.depth -= 1
            return node
        else
            return fail(p, "expected `,` or closing bracket")
        end
    end
    return -1
end

;; Parses a complete JSON document. Err(message) on any violation.
pub fn parse(b: hlib_bytes::Buf, max_depth: int) -> option::Result<JDoc, string> is
    if !hlib_bytes::utf8_valid(b, 0, b.n) is return option::Result::Err("invalid UTF-8") end
    let p: P = P { b: b, i: 0, err: "", depth: 0, max_depth: max_depth, nodes: [] }
    let root: int = parse_value(p)
    if root < 0 is return option::Result::Err(p.err) end
    ws(p)
    if p.i < b.n is return option::Result::Err("trailing characters at byte " + to_string(p.i)) end
    return option::Result::Ok(JDoc { nodes: p.nodes, root: root })
end

;; ── access ────────────────────────────────────────────────────────────────────

pub fn kind(d: JDoc, n: int) -> int is
    if n < 0 is return -1 end
    return d.nodes[n].kind
end

;; child of object `n` named `key`, or -1
pub fn get(d: JDoc, n: int, key: string) -> int is
    if n < 0 || d.nodes[n].kind != 5 is return -1 end
    let mut c: int = d.nodes[n].first
    while c >= 0 is
        if d.nodes[c].key == key is return c end
        c = d.nodes[c].next
    end
    return -1
end

;; i-th element of array `n`, or -1
pub fn at(d: JDoc, n: int, i: int) -> int is
    if n < 0 || d.nodes[n].kind != 4 is return -1 end
    let mut c: int = d.nodes[n].first
    let mut k: int = 0
    while c >= 0 is
        if k == i is return c end
        k += 1
        c = d.nodes[c].next
    end
    return -1
end

pub fn len(d: JDoc, n: int) -> int is
    if n < 0 is return 0 end
    return d.nodes[n].count
end

pub fn str_of(d: JDoc, n: int) -> string is
    if n < 0 is return "" end
    return d.nodes[n].s
end

pub fn bool_of(d: JDoc, n: int) -> bool is
    if n < 0 is return false end
    return d.nodes[n].kind == 1 && d.nodes[n].b
end

;; a non-negative integer (digits only, fits 18 digits), else -1
pub fn uint_of(d: JDoc, n: int) -> int is
    if n < 0 || d.nodes[n].kind != 2 is return -1 end
    let s: string = d.nodes[n].s
    if s.len() == 0 || s.len() > 18 is return -1 end
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        if c < 48 || c > 57 is return -1 end
        v = v * 10 + (c - 48)
        i += 1
    end
    return v
end

;; ── writing (serde_json compatible) ───────────────────────────────────────────

fn hexd(v: int) -> string is
    if v < 10 is return str_from_byte(48 + v) end
    return str_from_byte(87 + v)
end

;; a JSON string literal; non-ASCII stays raw UTF-8, like serde_json
pub fn quote(s: string) -> string is
    let mut sb = strbuf::new()
    sb.push("\"")
    let mut i: int = 0
    while i < s.len() is
        let c: int = byte_at(s, i)
        if c == 34 is sb.push("\\\"")
        elsif c == 92 is sb.push("\\\\")
        elsif c == 10 is sb.push("\\n")
        elsif c == 13 is sb.push("\\r")
        elsif c == 9 is sb.push("\\t")
        elsif c == 8 is sb.push("\\b")
        elsif c == 12 is sb.push("\\f")
        elsif c < 32 is sb.push("\\u00" + hexd(c / 16) + hexd(c % 16))
        else sb.push(str_from_byte(c)) end
        i += 1
    end
    sb.push("\"")
    return sb.build()
end

pub fn pad(n: int) -> string is
    let mut s: string = ""
    let mut i: int = 0
    while i < n is
        s += "  "
        i += 1
    end
    return s
end
